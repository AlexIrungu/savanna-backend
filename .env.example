# Server Configuration
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://AlexIrungu.github.io

# Gmail SMTP Configuration (for sending emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=journeyssavanna@gmail.com
EMAIL_PASS=your-app-password-here

# Business Email (where YOU receive booking notifications)
